// Generado por scripts/convertir_posturas_creencias.py; no editar a mano.
// Fuente: posturas-creencias.md
digraph posturas_creencias {
    graph [rankdir=TB, splines=spline, nodesep=0.35, ranksep=0.70,
           bgcolor="transparent", fontname="Segoe UI", fontsize=22,
           labelloc="t", label="Clasificación de posturas, creencias y doctrinas\n "];
    node  [fontname="Segoe UI", fontsize=11, margin="0.16,0.09"];
    edge  [fontname="Segoe UI", fontsize=9, color="#5A6672", arrowsize=0.7];

    Q1 [label="¿El universo fue causado por\nun Creador?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q2 [label="¿El Creador se identifica como\nDios?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q3 [label="¿Jesucristo realmente existió?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q4 [label="¿Jesús declaró ser Dios?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q5 [label="¿La evidencia de los milagros\nde Jesús son suficientes para\nconcluír que realmente\nocurrieron?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q6 [label="¿Jesús fue un profeta?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q7 [label="¿Jesús fue un engañador?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q8 [label="¿Jesús fue solo un sabio?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q9 [label="¿Jesús fue solamente una\npersona confundida?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q10 [label="¿Los milagros (especialmente\nsu resurección) y demás\nevidencias funcionan como\nsignos acreditativos de la\nidentidad divina declarada de\nJesús? (¿Jesús es Dios?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q11 [label="¿Es Jesucristo un ser creado?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q12 [label="¿Era Jesucristo inferior y\nsubordinado a Dios?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q13 [label="¿Era Jesucristo inicialmente\nun ser divino?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q14 [label="¿Es Jesús identificado como el\nArcángel Miguel?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q15 [label="¿Dios adoptó a Jesucristo como\nhijo posteriormente?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q16 [label="¿Jesucristo llegó a morir?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q17 [label="¿Jesucristo Resucitó?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q18 [label="¿El uso normativo y litúrgico\nque Jesucristo hace de las\nEscrituras hebreas es\nevidencia suficiente para\nreconocerlas como revelación\ndivina autoritativa? (¿El\nAntiguo Testamento tiene\nrevelación divina?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q19 [label="¿El reconocimiento de\nrelevación divina se extiende\nal conjunto del Tanaj/TaNaKh\n(antiguo Testamento), y no\nsolo a los libros expresamente\ncitados? (¿Todo el Antiguo\nTestamento es revelación\ndivina?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q20 [label="¿La comisión que Jesucristo\nconfiere a sus apóstoles para\ntransmitir su enseñanza, el\nreconocimiento recíproco entre\nlos apóstoles y la recepción\nde la iglesia primitiva es\nevidencia suficiente para\nreconocer el testimonio\napostólico como revelación\ndivina autoritativa? (¿Las\ncartas apostólicas son\nrevelación divina?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q21 [label="¿Solo las palabras de Jesús\ndentro del Nuevo Testamento\nson autoritativas?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q22 [label="¿La recepción universal de la\niglesia primitiva y el trato\nque da al resto de los\nescritos neotestamentarios, en\npie de igualdad con los ya\nreconocidos, son evidencia\nsuficiente para extenderles\nese mismo reconocimiento como\nrevelación divina\nautoritativa? (¿El Nuevo\nTestamento es revelación\ndivina?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q23 [label="¿El autotestimonio explícito\nde las escrituras\nautoritativas sobre su origen\ndivino, la atribución de sus\npalabras al Espíritu Santo\ncomo autor primario y su\nautoidentificación como\nPalabra de Dios con autoridad\ninquebrantable son evidencia\nsuficiente para concluír que\nes producto de la inspiración\ndivina (Teopneustia)? (¿La\nBiblia tiene inspiración\ndivina?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q24 [label="¿El pecado de Adán afectó a su\ndescendencia, el humano nace\nmuerto y en un estado de\n“pecador” (aunque no\nactivamente pecando)? (¿El\nhumano nace con una\n\"Naturaleza pecaminosa\"?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q25 [label="¿Antes del Discernimiento, la\ninocencia humana le da acceso\nal cielo y no puede pecar?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q26 [label="¿Después del Discernimiento el\nhumano puede pecar, el primer\npecado le condena al infierno,\npero **no pierde la capacidad\nde hacer el bien\nposteriormente aun si no tiene\nel perdón de Dios**?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q27 [label="¿Después de pecar, al pedir\nperdón a Dios, el humano es\nperdonado y gana derecho a\nentrar al cielo al morir?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q28 [label="¿El volver a pecar remueve del\nhumano el derecho a entrar al\ncielo?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q29 [label="¿Tiene el humano la capacidad\nde hacer bien?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q30 [label="¿La capacidad de hacer el bien\nes solo una capacidad “civil”\nde hacer el bien como \"amar a\nsus hijos\"?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q31 [label="¿Antes del Discernimiento y\naun con la capacidad de hacer\nel bien, el humano sigue\nestando condenado debido a su\nestado de muerte (naturaleza\npecaminosa) aun sin haber\ncometido pecado?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q32 [label="¿Es posible infundirle\n“gracia” (un Don divino que es\nposible perder) salvadora con\nsacramentos como el bautismo\nregenerador?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q33 [label="¿Para el humano, el no haber\nrecibido bautismo regenerador\nantes del Discernimiento, lo\ndeja condenado?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q34 [label="¿Lo deja condenado al Limbo?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q35 [label="¿Lo deja condenado al\nInfierno?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q36 [label="¿Después del Discernimiento el\nhumano inevitablemente peca?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q37 [label="¿Después de pecar pierde la\ncapacidad de tener fe (hacer\nobras salvíficas)?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q38 [label="¿Después de pecar puede\ndecidir tener fe (obras\nsalvíficas)?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q39 [label="¿Después del Discernimiento\nInevitablemente peca?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q40 [label="¿Después de pecar pierde la\ncapacidad de tener fe (hacer\nobras salvíficas)?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q41 [label="¿Solo Dios puede llamar o\nmover al individuo para\nproducir fe?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q42 [label="¿Después de pecar puede\ndecidir tener fe (obras\nsalvíficas)?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q43 [label="¿Fue Jesús, en algún momento,\nen sustancia, igual a Dios y,\npor tanto, poseyó una\nnaturaleza divina? (¿Dios es\nla misma sustancia que Jesús?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q44 [label="¿Se distinguen el Padre y el\nHijo de manera permanente y\nsimultánea, pudiendo uno\ndirigirse al otro como un yo a\nun tú, en lugar de ser el\nmismo y único sujeto\nmanifestándose sucesivamente\nbajo modos o papeles\ndistintos, aun compartiendo\nuna sola e idéntica substancia\ndivina? (¿Existe un Hijo\nEterno?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q45 [label="¿Jesús tuvo un cuerpo y\nnaturaleza humana real?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q46 [label="¿Jesús tuvo una mente/alma\nhumana racional completa?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q47 [label="¿Son el Verbo eterno y el\nhombre Jesús dos alguien\ndistintos, unidos tan\nestrechamente que actúan y son\nhonrados como uno solo, pero\nde modo que lo que le ocurre\nal hombre no le ocurre a Dios:\nJesús muere sin que Dios\nmuera, y María es madre del\nhombre y no de Dios? (¿Dios\nhabitaba dentro del hombre\nJesús como en un templo, sin\nser él mismo quien nació y\nmurió?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q48 [label="¿La naturaleza humana, al\nunirse con la divina, dejó de\nsubsistir con sus propias\npropiedades —no por haber\nfaltado, sino por haber sido\ntransformada, absorbida o\nmezclada en el acto mismo de\nla unión—, de modo que el\nCristo encarnado subsiste en\nuna sola naturaleza, aun\ncuando provenga de dos? (¿la\ndivinidad de Cristo anuló su\nhumanidad?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q49 [label="En el Getsemaní Cristo pedía\nal Padre pasára la copa, tenía\nla voluntad de morir mientras\nno quería hacerlo, ¿Tenía\nJesucristo dos voluntades?\n(¿Jesús podía querer como\nhombre algo distinto de lo que\nquería como Dios, y aun así\nobedecer?)", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q50 [label="¿La materia/realidad física es\neterna y no fue creada por un\nDios?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];
    Q51 [label="¿Es el universo mismo, en su\ntotalidad, de naturaleza\ndivina?", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#8A6D3B", fontcolor="#2F250D"];

