flowchart TD

    %% ----------------------------------------------------
    %% DEFINICIÓN DE CLASES (Opción A - Modo Oscuro)
    %% ----------------------------------------------------

    classDef inicio fill:#4A4A6E,stroke:#7A7AA6,color:#E8E8F5,stroke-width:2px,font-weight:bold;
    classDef pregunta fill:#1C1C2E,stroke:#4A4A6E,color:#B8B8D9,stroke-width:1.5px;
    classDef postura fill:#2E2E4D,stroke:#6C5CE7,color:#E8E8F5,stroke-width:1.5px,font-weight:bold;
    classDef resultado fill:#2E2E4D,stroke:#F4A261,color:#E8E8F5,stroke-width:1.5px;
    classDef alternativo fill:#4A4A6E,stroke:#B8B8D9,color:#E8E8F5,stroke-width:1.5px;




Unicitarismo["<b>Unicitarismo</b>"]:::postura
Trinitariano["<b>Trinitarismo</b>"]:::postura
Subordinacionista["<b>Subordinacionismo</b>"]:::postura
Arrianismo["<b>Arrianismo</b>"]:::postura

start([Inicio]):::inicio --> Creacion
    Creacion{"Cómo inició el universo?"}:::pregunta
        Creacion -- Fue causado por un Creador --> Creacionismo("<b>Creacionismo</b>"):::postura -->
            Creacionista{"Ese Creador se identifica como Dios?"} 
                Creacionista -- Si --> Teismo("<b>Teísmo</b>"):::postura --> Teista
                Creacionista -- No --> Deismo("<b>Deísmo</b>"):::postura --> Teista
                    Teista{"Quién fué Jesucristo?"} -- Solo un sabio --> Humanismo("<b>Humanismo</b>"):::postura --> Humanista{"Eres Judio?"}
                            Humanista -- Si --> Judaismo("<b>Judaísmo</b>"):::postura --> Judio("•  <br/>")
                            Humanista -- No --> Monoteísmo-unipersonal("<b>Monoteísmo-unipersonal</b>"):::postura --> Judaisante("• Judaisantes  <br/>")
                    Teista -- Subordinado a Dios --> Unitarianismo("<b>Unitarianismo</b>"):::postura --> Unitariano("• Islam <br/>")
                    Teista -- Es el Hijo de Dios --> Cristianismo("<b>Cristianismo</b>"):::postura--> Cristiano{"???"}
                        Cristiano -- Pero es otra entidad e inferior a Dios --> Subordinacionista{"<h4><font color='gray'>Subordinacionismo</font></h4><br/> ???"}
                            Teista -- Un engañador --> Miticista{"<h4><font color='gray'>Miticismo</font></h4><br/> ???"}
                            Teista -- Una persona confundida --> Miticista{"<h4><font color='gray'>Miticismo</font></h4><br/> ???"}
                        Cristiano -- Es Dios mismo --> Unicitarismo["<b>Unicitarismo</b>"]:::postura --> Unicitario{"???"}
                            Unicitarismo -- Es la misma persona y no es una persona individual--> Unicitarismo["<b>Unicitarismo</b>"]:::postura --> Unicitario{"???"}
                                Unicitario -- Es uno de los Hijos de Dios --> Arrianisata{"<h4><font color='gray'>Arrianismo</font></h4><br/> ???"}
                            Unicitarismo -- Es otra persona individual al mismo tiempo --> Trinitariano{"<h4><font color='gray'>Trinitarianismo</font></h4><br/> ???"}
                        
                    Teista -- Nunca Existió --> Miticista{"<h4><font color='gray'>Miticismo</font></h4><br/> ???"}
                    
        Creacion -- Siempre ha existido --> Ateismo("Ateismo?")
        Creacion -- Alguna otra? --> Ateismo("Ateismo?")
    



